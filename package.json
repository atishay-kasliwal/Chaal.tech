{
	"name": "chaal-tech",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"format": "prettier --write .",
		"server": "node --env-file-if-exists=.env server/index.mjs",
		"dev:backend": "wrangler dev --config wrangler.game.toml --local --var ENGINE_BUILD:dev",
		"deploy:backend": "node scripts/deploy-backend.mjs",
		"test:cloudflare": "node scripts/test-cloudflare-worker.mjs",
		"deploy:pages": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
		"test": "node --test tests/server/*.test.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "npm run check",
		"format:check": "prettier --check .",
		"phase1:browser": "node scripts/phase1/browser.mjs",
		"phase4:browser": "node scripts/phase4/browser.mjs",
		"phase5:browser": "node scripts/phase5/browser.mjs",
		"phase6:browser": "node scripts/phase6/browser.mjs",
		"club": "node --env-file-if-exists=.env scripts/club-members.mjs",
		"bots:migrate": "node --env-file-if-exists=.env scripts/bots-migrate.mjs",
		"analytics:migrate": "node --env-file-if-exists=.env scripts/analytics-migrate.mjs",
		"analytics:replay": "node --env-file-if-exists=.env scripts/analytics-replay.mjs",
		"analytics:health": "node --env-file-if-exists=.env scripts/analytics-health.mjs",
		"analytics:validate": "node --env-file-if-exists=.env scripts/analytics-validate.mjs",
		"analytics:corpus": "node scripts/replay-corpus.mjs",
		"analytics:intel:migrate": "node --env-file-if-exists=.env scripts/analytics-intel.mjs migrate",
		"analytics:export": "node --env-file-if-exists=.env scripts/analytics-intel.mjs export",
		"analytics:quality": "node --env-file-if-exists=.env scripts/analytics-intel.mjs quality",
		"analytics:benchmark": "node scripts/analytics-benchmark.mjs",
		"analytics:simulate": "node scripts/intel-simulate.mjs",
		"bots:memory:migrate": "node --env-file-if-exists=.env scripts/bot-memory.mjs migrate",
		"bots:memory:rebuild": "node --env-file-if-exists=.env scripts/bot-memory.mjs rebuild",
		"bots:memory:health": "node --env-file-if-exists=.env scripts/bot-memory.mjs health",
		"bots:moments:index": "node --env-file-if-exists=.env scripts/bot-moments.mjs",
		"bots:publish-v3": "node --env-file-if-exists=.env scripts/bots-publish-v3.mjs",
		"bots:simulate": "node scripts/bot-memory-simulate.mjs",
		"sim:phase1": "node scripts/sim/phase1-report.mjs --seed 1 --hands 200",
		"sim:phase11": "node scripts/sim/phase11-report.mjs --seed 11 --hands 200",
		"sim:phase2": "node --max-old-space-size=8192 scripts/sim/phase2-report.mjs --seed 21 --hands 200",
		"sim:tune": "node --max-old-space-size=8192 scripts/sim/tune.mjs",
		"bots:explain": "node --env-file-if-exists=.env scripts/bots-explain.mjs",
		"sim:explain": "node scripts/sim/explain.mjs",
		"sim:graph": "node scripts/sim/graph.mjs",
		"sim:phase3": "node --max-old-space-size=8192 scripts/sim/phase3.mjs --seed 41",
		"sim:phase3:report": "node --max-old-space-size=8192 scripts/sim/phase3-report.mjs --league .sim/phase3/league-41.json --seed 51",
		"sim:phase3:all": "caffeinate -ims sh -c 'npm run sim:phase3 && npm run sim:phase3:report'",
		"bots:publish-dna": "node --env-file-if-exists=.env scripts/bots-publish-dna.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"axe-core": "^4.14.0",
		"daisyui": "^5.7.47",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"mongodb-memory-server": "^10.4.3",
		"playwright": "1.64.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "8.71.2",
		"vite": "^8.3.3",
		"wrangler": "^4.151.0"
	},
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "^1.52.0",
		"gsap": "^3.15.0",
		"jose": "^6.2.12",
		"lenis": "^1.3.27",
		"livekit-client": "2.22.4",
		"livekit-server-sdk": "2.19.1",
		"mongodb": "^6.21.0",
		"socket.io": "4.8.4",
		"socket.io-client": "^4.8.4",
		"socket.io-msgpack-parser": "^3.0.2"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "4.64.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"socket.io-parser": "4.2.7",
		"ws": "8.21.3"
	}
}
