# Local Cloudflare Worker endpoint; production builds require the deployed Worker HTTPS origin.
VITE_SERVER_URL=http://127.0.0.1:8787
# Local Wrangler secret only. Use a different value in Cloudflare production secrets.
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Backend Worker settings.
ALLOWED_ORIGINS=https://chaal.tech,https://www.chaal.tech,https://chaal-tech.pages.dev,http://127.0.0.1:5173,http://localhost:5173
TURN_TIMEOUT_MS=60000
HOST_GRACE_MS=30000
# Optional LiveKit secrets. Leave all three unset to play without media.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Optional email invites through Resend. Without a key the invite panel still shares links.
# RESEND_API_KEY=re_...
# INVITE_FROM=Chaal <invites@chaal.tech>
# PUBLIC_APP_URL=http://127.0.0.1:5173
