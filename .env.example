# Public owned game service; never put secrets in VITE_ variables.
VITE_SERVER_URL=http://127.0.0.1:8080
# Backend-only settings (Node 24+).
PORT=8080
HOST=127.0.0.1
GAME_DATABASE=data/teen-patti.sqlite
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
TURN_TIMEOUT_MS=60000
# Optional media; backend only. Leave all three unset to play without media.
# Local development: livekit-server --dev --bind 127.0.0.1
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
